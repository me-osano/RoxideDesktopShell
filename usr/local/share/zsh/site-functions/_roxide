    case $state in
    (brightness)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:roxide-brightness-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--ddc[Include DDC/I2C monitors (slower)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(get)
