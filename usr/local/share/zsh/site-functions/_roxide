(( $+functions[_roxide_commands] )) ||
_roxide_commands() {
    local commands; commands=(
'run:Run ROXIDE (daemon and/or session)' \
'daemon:Start the daemon directly (internal use)' \
'stop:Stop the ROXIDE daemon' \
'status:Check daemon status' \
'restart:Restart ROXIDE (stop and restart session)' \
'sysmon:Print system snapshot with diagnostics' \
'search:Search files' \
'weather:Print weather snapshot' \
'niri:Niri IPC commands' \
'brightness:Brightness control' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'roxide commands' commands "$@"
}
