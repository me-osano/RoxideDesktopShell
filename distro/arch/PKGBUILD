pkgname=RoxideDesktopShell
pkgver=0.1.0
pkgrel=1
pkgdesc="ROXIDE - A handcrafted Wayland desktop shell for niri, built with Quickshell/QML and Rust"
arch=('x86_64')
url="https://github.com/me-osano/RoxideDesktopShell"
license=('MIT')
depends=(
  'niri'
  'quickshell'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  'qt6-imageformats'
  'kirigami'
  'sonnet'
  'pipewire'
  'wireplumber'
  'networkmanager'
  'greetd'
  'systemd'
)
makedepends=(
  'rust'
  'cargo'
  'pkgconf'
  'qt6-tools'
)
optdepends=(
  'greetd: for greeter functionality'
  'upower: battery monitoring'
  'bluez: bluetooth support'
)
source=("${pkgname}::git+https://github.com/me-osano/RoxideDesktopShell.git")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  
  # Build Rust core
  cd core
  cargo build --release --manifest-path Cargo.toml
  
  # Return to root and setup quickshell config
  cd ..
}

package() {
  cd "$pkgname"
  
  # Install Rust daemon
  install -Dm755 core/target/release/roxide "$pkgdir/usr/bin/roxide"
  
  # Install Quickshell configuration
  install -d "$pkgdir/etc/roxide/quickshell"
  cp -r quickshell/* "$pkgdir/etc/roxide/quickshell/"
  
  # Install man pages if available (optional)
  # install -Dm644 docs/*.1 "$pkgdir/usr/share/man/man1/"
  
  # Install systemd service
  install -Dm644 distro/arch/roxide.service "$pkgdir/usr/lib/systemd/user/roxide.service"
  
  # Install bash completion (if exists)
  # install -Dm644 completions/roxide.bash "$pkgdir/usr/share/bash-completion/completions/roxide"
}