[Unit]
Description=ROXIDE desktop shell daemon
Documentation=https://github.com/me-osano/RoxideDesktopShell
After=graphical-session.target
PartOf=graphical-session.target
Wants=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/roxide daemon
Restart=on-failure
RestartSec=3s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=roxide

# Environment
Environment=ROXIDE_LOG=info

[Install]
WantedBy=graphical-session.target
